# Postgres (Neon)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# YouTube API keys (rotate up to 10 — code reads YOUTUBE_API_KEY (legacy) + _1..10)
YOUTUBE_API_KEY_1=
YOUTUBE_API_KEY_2=
YOUTUBE_API_KEY_3=
YOUTUBE_API_KEY_4=
YOUTUBE_API_KEY_5=

# Email sending (Pilar 2 lite — multi-sender pool via Resend)
RESEND_API_KEY=
SENDER_EMAIL_1=g@clipzi.dev
SENDER_EMAIL_2=
SENDER_EMAIL_3=
# ...up to SENDER_EMAIL_20. Each inbox must be verified in Resend.
SENDER_NAME=Gonzalo Orsi
# Daily send limit PER INBOX. Total daily capacity = N_senders * DAILY_SEND_CAP.
DAILY_SEND_CAP=100

# Cron auth (Vercel injects this header automatically)
CRON_SECRET=

# Admin password for the /dashboard. Required (middleware fails closed if unset).
# Use a strong random string. Stored only as env — the cookie holds sha256
# of this value, never the password itself.
ADMIN_PASSWORD=

# % of each send tick allocated to agencies vs creators (0-100, default 20).
# Agencies have higher per-conversion value (multiple creators each), so even
# a modest split yields strong leverage. Adjust based on response signals.
AGENCY_SEND_RATIO=20

# % of each send tick allocated to standup vertical (comedians + clubs/schools/
# festivals/productions) (0-100, default 10). Creators get the remainder
# (100 - AGENCY_SEND_RATIO - STANDUP_SEND_RATIO - MEDIA_ORG_SEND_RATIO). If the
# sum of the slot ratios exceeds 100, all three are scaled down proportionally.
STANDUP_SEND_RATIO=10

# % of each send tick allocated to media-org vertical (radios + podcast networks
# + streaming-TV channels like Olga/Luzu/Vorterix) (0-100, default 10).
MEDIA_ORG_SEND_RATIO=10

# % of each send tick allocated to journalists (independent video journalists +
# press unions/associations/schools) (0-100, default 10).
JOURNALIST_SEND_RATIO=10

# % of each send tick allocated to photographers/videographers (individuals +
# studios/associations) (0-100, default 10).
PHOTOGRAPHER_SEND_RATIO=10

# % of each send tick allocated to linkbuilding (marketing/SEO blogs, AI-tool
# listicle authors and SaaS directories we ask for a Clipzi backlink) (0-100,
# default 20). Deliberately EXCLUDED from backfill: linkbuilding never exceeds
# its ratio even when other pools run dry (finite pool of quality sites).
LINKBUILDING_SEND_RATIO=20

# % of each send tick allocated to churches (evangelical churches + Christian
# ministries with active YouTube channels, pilot AR/MX/CO/BR) (0-100, default 10).
CHURCH_SEND_RATIO=10

# Email verification (Bouncer). Discovery demotes undeliverable emails to
# low_quality. Fails open if unset or out of credits.
BOUNCER_API_KEY=

# Outreach digest email — ONE summary per day of the last 24h of sends, sent by
# /api/cron/daily-report at 00:00 UTC (= 21:00 ART). The hourly send cron itself
# no longer emails per tick.
# REPORT_EMAIL defaults to gonzaloorsi@gmail.com if unset.
# REPORT_FROM_EMAIL must be on a Resend-verified domain — falls back to
# SENDER_EMAIL_1 if unset.
REPORT_EMAIL=
REPORT_FROM_EMAIL=

# LLM personalization (Pilar 3 — coming later)
ANTHROPIC_API_KEY=

# Vercel AI Gateway (used by /api/cron/agency-discovery → Perplexity Sonar).
# Setup: Vercel project → Settings → AI → Enable AI Gateway, add Perplexity
# as a provider, then set the auto-generated key here.
AI_GATEWAY_API_KEY=

# YouTube v2 cold email ("most replayed" hook, lib/heatmap.ts).
# Share of YouTube creators that get the v2 templates instead of creator-* (v1).
# 50 = A/B 50/50 by channel-id hash, 100 = v2 for everyone, 0 = v1 only.
YOUTUBE_V2_RATIO=
# Channels enriched per hourly hot-moments tick (default 400, ~2 Data API
# units each).
HOT_MOMENTS_PER_TICK=

# Frame attachment for the v2 email (lib/frames.ts): hot-moments asks the
# clipzi Modal app to render the "most replayed" still into R2; the send cron
# attaches it. Same Modal workspace/tokens as the clipzi project. FRAME_PUBLIC_BASE
# is the public host of the R2 clips bucket (clipzi R2_PUBLIC_HOST).
MODAL_FRAME_URL=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
FRAME_PUBLIC_BASE=https://clips.clipzi.cc

# Resend webhook (app/api/webhook/resend): hard bounces + spam complaints
# update sends/channels and add complaints to unsubscribes. Create the
# endpoint in Resend → Webhooks with ONLY email.bounced and email.complained,
# then paste its signing secret (whsec_...) here.
RESEND_WEBHOOK_SECRET=
