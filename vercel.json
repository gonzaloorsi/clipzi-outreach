    "app/api/cron/media-org-discovery/route.ts": {
      "maxDuration": 800
    },
    "app/api/cron/journalist-discovery/route.ts": {
      "maxDuration": 800
    },
    "app/api/cron/photographer-discovery/route.ts": {
      "maxDuration": 800
    },
    "app/api/cron/linkbuilding-discovery/route.ts": {
      "maxDuration": 800
    },
    "app/api/cron/linkbuilding-followup/route.ts": {
      "maxDuration": 300
